// PostgreSQL checks, partial indexes and deferred triggers also live in migrations.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Example syntax only — uncomment or replace when designing your schema:
// model Example {
//   id   String @id @default(uuid()) @db.Uuid
//   name String
// }

enum Role {
  ADMIN
  REVIEWER
  CLIENT
}

enum Category {
  REFUND_REQUEST
  TECHNICAL_SUPPORT
  INVOICE_REQUEST
  GENERAL_QUESTION
  OTHER
}

enum Status {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  NEEDS_REVIEW
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  role               Role
  // Store a password hash produced by the application, never a raw password.
  passwordHash       String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  requests           Request[]
  auditEvents        AuditEvent[]
  sessions           Session[]
  businessMembership BusinessMembership?
}

model Session {
  tokenHash String   @id @db.VarChar(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model Request {
  id             String     @id @default(uuid()) @db.Uuid
  rawText        String
  createdById    String     @db.Uuid
  createdBy      User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  idempotencyKey String
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  workflows      Workflow[]

  @@unique([createdById, idempotencyKey])
  @@index([createdAt, id])
}

model Workflow {
  id          String       @id @default(uuid()) @db.Uuid
  requestId   String       @db.Uuid
  request     Request      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  category    Category?
  status      Status       @default(PENDING)
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  completedAt DateTime?    @db.Timestamptz(3)
  auditEvents AuditEvent[]

  @@index([requestId])
  @@index([status, updatedAt])
}

enum ActorType {
  USER
  SYSTEM
  WORKER
}

// Append-only through application code. Database-level enforcement can be
// added in a reviewed migration; relations preserve the referenced history.
model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  runId      String?   @db.Uuid
  run        Workflow? @relation(fields: [runId], references: [id], onDelete: Restrict)
  businessId String?   @db.Uuid
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entityType String?
  entityId   String?   @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  eventType  String
  traceId    String
  // Store only redacted details, not credentials or full customer messages.
  metadata   Json?     @db.JsonB
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([runId, createdAt])
  @@index([actorId])
  @@index([traceId])
  @@index([businessId, createdAt])
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Synthetic orders only; orderNumber is the identifier supplied in requests.
model MockOrder {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  status      OrderStatus @default(PROCESSING)
  deliveredAt DateTime?   @db.Timestamptz(3)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("AUD") @db.VarChar(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
}

enum BusinessRole {
  OWNER
  STAFF
}

enum SlotState {
  AVAILABLE
  RESERVED
  BLOCKED
}

model Business {
  workflowDefinitions       BusinessWorkflowDefinition[]
  workflowRuns              BusinessWorkflowRun[]
  workflowTasks             BusinessTask[]
  workflowActions           BusinessWorkflowAction[]
  mockRemindersEnabled      Boolean                      @default(false)
  id                        String                       @id @default(uuid()) @db.Uuid
  slug                      String                       @unique
  name                      String
  timezone                  String                       @default("Australia/Brisbane")
  active                    Boolean                      @default(true)
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @db.Timestamptz(3)
  memberships               BusinessMembership[]
  staff                     Staff[]
  services                  Service[]
  slots                     AvailabilitySlot[]
  auditEvents               AuditEvent[]
  maxBookingDurationMinutes Int                          @default(120)
  customerSessions          CustomerSession[]
  bookingProposals          BookingProposal[]
  bookings                  Booking[]
  bookingActions            BookingAction[]
  closures                  ScheduleClosure[]
  notificationOutbox        NotificationOutbox[]
}

// One business per dashboard user in Phase 1. Legacy User.role is unchanged.
model BusinessMembership {
  completedWorkflowTasks BusinessTask[]
  workflowActions        BusinessWorkflowAction[]
  id                     String                   @id @default(uuid()) @db.Uuid
  businessId             String                   @db.Uuid
  business               Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId                 String                   @unique @db.Uuid
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                   BusinessRole
  active                 Boolean                  @default(true)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([businessId, id])
  @@index([businessId])
}

model Staff {
  id               String             @id @default(uuid()) @db.Uuid
  businessId       String             @db.Uuid
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  slug             String
  displayName      String
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  slots            AvailabilitySlot[]
  bookingProposals BookingProposal[]
  closures         ScheduleClosure[]

  @@unique([businessId, id])
  @@unique([businessId, slug])
}

// Dated business/staff closure policy, independent of existing inventory.
// Active exact-window uniqueness and closure/slot guards are in SQL migrations.
model ScheduleClosure {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staffId    String?   @db.Uuid
  staff      Staff?    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  startAt    DateTime  @db.Timestamptz(3)
  endAt      DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)

  @@index([businessId, startAt, endAt])
  @@index([businessId, staffId])
}

model Service {
  id               String            @id @default(uuid()) @db.Uuid
  businessId       String            @db.Uuid
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  slug             String
  name             String
  durationMinutes  Int               @default(30)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  bookingProposals BookingProposal[]

  @@unique([businessId, id])
  @@unique([businessId, slug])
}

// Fixed 30-minute inventory only, not an appointment or a reservation API.
model AvailabilitySlot {
  id               String            @id @default(uuid()) @db.Uuid
  businessId       String            @db.Uuid
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  staffId          String            @db.Uuid
  staff            Staff             @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  startAt          DateTime          @db.Timestamptz(3)
  endAt            DateTime          @db.Timestamptz(3)
  state            SlotState         @default(AVAILABLE)
  bookingProposals BookingProposal[]
  bookingSlots     BookingSlot[]

  @@unique([staffId, startAt])
  @@unique([businessId, staffId, id])
  @@index([businessId, startAt, staffId])
}

// Separate from staff login; ownership rows survive token expiry/revocation.
model CustomerSession {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  tokenHash  String            @unique @db.VarChar(64)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime          @db.Timestamptz(3)
  revokedAt  DateTime?         @db.Timestamptz(3)
  proposals  BookingProposal[]
  bookings   Booking[]
  actions    BookingAction[]

  @@unique([businessId, id])
  @@index([expiresAt])
}

// Immutable selection snapshot; a unique Booking consumes this proposal.
model BookingProposal {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sessionId       String           @db.Uuid
  session         CustomerSession  @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Restrict)
  serviceId       String           @db.Uuid
  service         Service          @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Restrict)
  staffId         String           @db.Uuid
  staff           Staff            @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Restrict)
  slotId          String           @db.Uuid
  slot            AvailabilitySlot @relation(fields: [businessId, staffId, slotId], references: [businessId, staffId, id], onDelete: Restrict)
  durationMinutes Int
  startAt         DateTime         @db.Timestamptz(3)
  endAt           DateTime         @db.Timestamptz(3)
  timezone        String           @db.VarChar(100)
  serviceName     String           @db.VarChar(160)
  staffName       String           @db.VarChar(120)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime         @db.Timestamptz(3)
  booking         Booking?         @relation("ConsumedProposal")
  rescheduleOfId  String?          @db.Uuid
  rescheduleOf    Booking?         @relation("RescheduleSource", fields: [businessId, sessionId, rescheduleOfId], references: [businessId, sessionId, id], onDelete: NoAction, map: "BookingProposal_reschedule_source_fkey")
  actions         BookingAction[]

  @@unique([businessId, sessionId, id])
  @@index([expiresAt])
  @@index([rescheduleOfId])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum BookingOperation {
  PROPOSE
  CONFIRM
  CANCEL
  RESCHEDULE
}

model Booking {
  workflowRuns        BusinessWorkflowRun[]
  workflowTasks       BusinessTask[]
  id                  String                @id @default(uuid()) @db.Uuid
  businessId          String                @db.Uuid
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sessionId           String                @db.Uuid
  session             CustomerSession       @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Restrict)
  proposalId          String                @unique @db.Uuid
  proposal            BookingProposal       @relation("ConsumedProposal", fields: [businessId, sessionId, proposalId], references: [businessId, sessionId, id], onDelete: Restrict)
  rescheduleProposals BookingProposal[]     @relation("RescheduleSource")
  reference           String                @unique @db.VarChar(64)
  status              BookingStatus         @default(CONFIRMED)
  customerName        String                @db.VarChar(120)
  customerEmail       String                @db.VarChar(254)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  cancelledAt         DateTime?             @db.Timestamptz(3)
  slots               BookingSlot[]
  actions             BookingAction[]
  notificationEvents  NotificationOutbox[]  @relation("OutboxBooking")
  replacementEvents   NotificationOutbox[]  @relation("OutboxPreviousBooking")

  @@unique([businessId, id])
  @@unique([businessId, sessionId, id])
  @@unique([businessId, sessionId, proposalId, id])
  @@unique([businessId, sessionId, proposalId])
  @@index([businessId, createdAt, id])
}

// Partial unique index prevents two unreleased claims on the same base slot.
model BookingSlot {
  bookingId  String           @db.Uuid
  businessId String           @db.Uuid
  booking    Booking          @relation(fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict)
  staffId    String           @db.Uuid
  slotId     String           @db.Uuid
  slot       AvailabilitySlot @relation(fields: [businessId, staffId, slotId], references: [businessId, staffId, id], onDelete: Restrict)
  releasedAt DateTime?        @db.Timestamptz(3)

  @@id([bookingId, slotId])
  @@index([slotId])
}

// Successful operation DTO snapshots only; never store raw tokens here.
model BookingAction {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sessionId          String           @db.Uuid
  session            CustomerSession  @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Restrict)
  operation          BookingOperation
  idempotencyKey     String           @db.VarChar(128)
  requestFingerprint String           @db.VarChar(64)
  proposalId         String           @db.Uuid
  proposal           BookingProposal  @relation(fields: [businessId, sessionId, proposalId], references: [businessId, sessionId, id], onDelete: Restrict)
  bookingId          String?          @db.Uuid
  booking            Booking?         @relation(fields: [businessId, sessionId, proposalId, bookingId], references: [businessId, sessionId, proposalId, id], onDelete: Restrict)
  response           Json             @db.JsonB
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([businessId, sessionId, operation, idempotencyKey])
  @@index([proposalId])
  @@index([bookingId])
}

enum NotificationEventType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_REMINDER
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD
}

// Immutable minimal event identity plus publisher retry/lease state.
model NotificationOutbox {
  workflowRuns      BusinessWorkflowRun[]
  receipt           MockNotificationReceipt?
  id                String                   @id @default(uuid()) @db.Uuid
  schemaVersion     Int                      @default(1)
  eventType         NotificationEventType
  deliveryMode      String                   @default("MOCK") @db.VarChar(16)
  businessId        String                   @db.Uuid
  business          Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  bookingId         String                   @db.Uuid
  booking           Booking                  @relation("OutboxBooking", fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict)
  previousBookingId String?                  @db.Uuid
  previousBooking   Booking?                 @relation("OutboxPreviousBooking", fields: [businessId, previousBookingId], references: [businessId, id], onDelete: Restrict)
  occurredAt        DateTime                 @db.Timestamptz(3)
  traceId           String                   @db.VarChar(128)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  status            OutboxStatus             @default(PENDING)
  availableAt       DateTime                 @db.Timestamptz(3)
  attempts          Int                      @default(0)
  leaseToken        String?                  @db.Uuid
  leaseExpiresAt    DateTime?                @db.Timestamptz(3)
  publishedAt       DateTime?                @db.Timestamptz(3)
  lastErrorCode     String?                  @db.VarChar(64)

  @@unique([businessId, bookingId, eventType])
  @@unique([businessId, bookingId, id])
  @@index([status, availableAt, id])
  @@index([businessId, occurredAt, id])
  @@index([businessId, previousBookingId])
}

enum BusinessWorkflowTemplate {
  PREPARE_APPOINTMENT
  FOLLOW_UP_ENQUIRY
}

enum BusinessWorkflowRunStatus {
  PENDING
  SUCCEEDED
  SUPPRESSED
  DEAD
}

enum BusinessTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BusinessWorkflowOperation {
  SET_POLICY
  COMPLETE_TASK
  RECORD_ENQUIRY
}

model BusinessWorkflowDefinition {
  id           String                   @id @default(uuid()) @db.Uuid
  businessId   String                   @db.Uuid
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  template     BusinessWorkflowTemplate
  enabled      Boolean                  @default(false)
  revision     Int                      @default(1)
  activationId String?                  @db.Uuid
  enabledAt    DateTime?                @db.Timestamptz(3)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  runs         BusinessWorkflowRun[]
  tasks        BusinessTask[]
  actions      BusinessWorkflowAction[]

  @@unique([businessId, template])
  @@unique([businessId, id])
}

model BusinessWorkflowRun {
  enquiryActions BusinessWorkflowAction[]
  id             String                     @id @default(uuid()) @db.Uuid
  businessId     String                     @db.Uuid
  business       Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  definitionId   String                     @db.Uuid
  definition     BusinessWorkflowDefinition @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Restrict)
  bookingId      String                     @db.Uuid
  booking        Booking                    @relation(fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict)
  triggerEventId String                     @db.Uuid
  triggerEvent   NotificationOutbox         @relation(fields: [businessId, bookingId, triggerEventId], references: [businessId, bookingId, id], onDelete: Restrict)
  activationId   String                     @db.Uuid
  policyRevision Int
  status         BusinessWorkflowRunStatus  @default(PENDING)
  attempts       Int                        @default(0)
  availableAt    DateTime                   @db.Timestamptz(3)
  leaseToken     String?                    @db.Uuid
  leaseExpiresAt DateTime?                  @db.Timestamptz(3)
  resultCode     String?                    @db.VarChar(64)
  lastErrorCode  String?                    @db.VarChar(64)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?                  @db.Timestamptz(3)
  task           BusinessTask?

  @@unique([businessId, definitionId, bookingId])
  @@unique([businessId, definitionId, triggerEventId])
  @@unique([businessId, definitionId, bookingId, id])
  @@unique([businessId, definitionId, id])
  @@index([status, availableAt, id])
}

model BusinessTask {
  id                      String                     @id @default(uuid()) @db.Uuid
  businessId              String                     @db.Uuid
  business                Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  definitionId            String                     @db.Uuid
  definition              BusinessWorkflowDefinition @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Restrict)
  runId                   String                     @unique @db.Uuid
  bookingId               String                     @db.Uuid
  booking                 Booking                    @relation(fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict)
  run                     BusinessWorkflowRun        @relation(fields: [businessId, definitionId, bookingId, runId], references: [businessId, definitionId, bookingId, id], onDelete: Restrict)
  kind                    BusinessWorkflowTemplate
  status                  BusinessTaskStatus         @default(OPEN)
  dueAt                   DateTime                   @db.Timestamptz(3)
  revision                Int                        @default(1)
  completedByMembershipId String?                    @db.Uuid
  completedBy             BusinessMembership?        @relation(fields: [businessId, completedByMembershipId], references: [businessId, id], onDelete: Restrict)
  completedAt             DateTime?                  @db.Timestamptz(3)
  closedAt                DateTime?                  @db.Timestamptz(3)
  invalidatedAt           DateTime?                  @db.Timestamptz(3)
  invalidationReason      String?                    @db.VarChar(64)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(3)
  actions                 BusinessWorkflowAction[]

  @@unique([businessId, definitionId, bookingId])
  @@unique([businessId, definitionId, id])
  @@unique([businessId, definitionId, bookingId, runId])
  @@index([businessId, status, dueAt, id])
}

model BusinessWorkflowAction {
  runId              String?                    @db.Uuid
  run                BusinessWorkflowRun?       @relation(fields: [businessId, definitionId, runId], references: [businessId, definitionId, id], onDelete: Restrict)
  id                 String                     @id @default(uuid()) @db.Uuid
  businessId         String                     @db.Uuid
  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membershipId       String                     @db.Uuid
  membership         BusinessMembership         @relation(fields: [businessId, membershipId], references: [businessId, id], onDelete: Restrict)
  definitionId       String                     @db.Uuid
  definition         BusinessWorkflowDefinition @relation(fields: [businessId, definitionId], references: [businessId, id], onDelete: Restrict)
  taskId             String?                    @db.Uuid
  task               BusinessTask?              @relation(fields: [businessId, definitionId, taskId], references: [businessId, definitionId, id], onDelete: Restrict)
  operation          BusinessWorkflowOperation
  idempotencyKey     String                     @db.VarChar(128)
  requestFingerprint String                     @db.VarChar(64)
  response           Json                       @db.JsonB
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)

  @@unique([businessId, membershipId, operation, idempotencyKey])
  @@index([businessId, createdAt, id])
}

// The mock effect and deduplication receipt are the same atomic database row.
model MockNotificationReceipt {
  eventId     String             @id @db.Uuid
  event       NotificationOutbox @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outcome     String             @db.VarChar(24)
  reason      String             @db.VarChar(32)
  processedAt DateTime           @default(now()) @db.Timestamptz(3)
}

// Redacted quarantine: no body, recipient, raw error or broker credentials.
model MockNotificationRejection {
  fingerprint String   @id @db.VarChar(64)
  reason      String   @db.VarChar(32)
  receivedAt  DateTime @default(now()) @db.Timestamptz(3)
}
