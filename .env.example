# Local synthetic development only. Do not reuse these credentials outside localhost.
API_HOST=127.0.0.1
API_PORT=3001
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=flowpilot_local_only
POSTGRES_PORT=5432
RABBITMQ_USER=flowpilot
RABBITMQ_PASSWORD=flowpilot_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# PostgreSQL is required for Phase 1; RabbitMQ execution is a later phase.
DATABASE_URL=postgresql://flowpilot:flowpilot_local_only@127.0.0.1:5432/flowpilot
RABBITMQ_URL=amqp://flowpilot:flowpilot_local_only@127.0.0.1:5672
NODE_ENV=development
DEMO_AUTH_ENABLED=true
DEMO_PASSWORD=flowpilot_demo_only
WEB_ORIGIN=http://127.0.0.1:5173
# Test preparation creates/migrates this isolated local database only.
TEST_DATABASE_URL=postgresql://flowpilot:flowpilot_local_only@127.0.0.1:5432/flowpilot_test
# Optional reproducible two-week salon inventory start (business-local YYYY-MM-DD).
# If omitted, seeding starts on today's date in Australia/Brisbane.
# SEED_START_DATE=2026-11-16

# Optional local AI. Default mock keeps development/CI independent of Ollama.
# Only the backend contacts this loopback endpoint; never expose it publicly.
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=20000


