{
  "name": "@flowpilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/app.test.ts src/business-time.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx --test src/phase1.integration.test.ts src/business.integration.test.ts"
  },
  "dependencies": {
    "@flowpilot/contracts": "workspace:*",
    "@flowpilot/db": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15"
  }
}

