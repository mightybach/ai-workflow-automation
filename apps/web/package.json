{
  "name": "@flowpilot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:ai:ui": "node --env-file-if-exists=../../.env tests/local-ai.mjs",
    "test:ui": "node --env-file-if-exists=../../.env tests/business-setup.mjs && node --env-file-if-exists=../../.env tests/phase1.mjs && node --env-file-if-exists=../../.env tests/customer-booking.mjs"
  },
  "dependencies": {
    "@flowpilot/contracts": "workspace:*",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.0",
    "vite": "8.3.8"
  }
}
